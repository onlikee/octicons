{
  "name": "@onlikee/octicons",
  "version": "1.0.0",
  "description": "Framework-independent GitHub Primer Octicons data and SVG utilities.",
  "type": "module",
  "license": "MIT",
  "author": "UnderHear",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlikee/octicons-vue.git",
    "directory": "packages/octicons"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "LICENSE.octicons",
    "NOTICE",
    "SOURCE.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/__generated__/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./svg/*.svg": "./dist/svg/*.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "node ../../scripts/generate.mjs && tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/generate.mjs && vite build && node ../../scripts/build-svg.mjs",
    "prepack": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
