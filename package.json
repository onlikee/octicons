{
  "name": "onlikee-octicons",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "UnderHear",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlikee/octicons-vue.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync:octicons": "node scripts/sync-octicons.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "npm run typecheck --workspaces && vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run build --workspace=@onlikee/octicons && npm run build --workspace=@onlikee/octicons-vue",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "vite --config tests/browser/vite.config.ts --host 127.0.0.1",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5",
    "svgson": "5.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
