{
  "name": "onlikee-octicons",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "UnderHear",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlikee/octicons.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "npm run typecheck --workspaces && vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run build --workspace=@onlikee/octicons && npm run build --workspace=@onlikee/octicons-vue",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "vite --config tests/browser/vite.config.ts --host 127.0.0.1",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "svgson": "5.2.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
